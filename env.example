# Inference provider credentials — never commit real secrets.
INFERENCE_PROVIDER_API_KEY=
INFERENCE_PROVIDER_BASE_URL=
INFERENCE_TARGET_MODEL=gpt-4o-mini

# Local development storage.
DATABASE_PATH=data/inbound_arbitrage.db

# Comma-separated exact frontend origins; configure after deploying.
CORS_ORIGINS=http://localhost:8000

# Usage limits.
DAILY_REQUEST_LIMIT=100
PER_CLIENT_PER_MINUTE=5
